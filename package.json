{
  "name": "blog-dongho",
  "version": "1.1.1",
  "type": "module",
  "description": "동호의 블로그 (Astro Micro 기반)",
  "scripts": {
    "sync": "node scripts/sync-attachments.mjs",
    "dev": "node scripts/sync-attachments.mjs && astro dev",
    "start": "pnpm run dev",
    "build": "node scripts/sync-attachments.mjs && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:migrate": "node --test scripts/migrate/*.test.mjs",
    "migrate:notion": "node scripts/migrate/migrate-notion.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.10",
    "astro-pagefind": "^1.8.5",
    "clsx": "^2.1.1",
    "pretendard": "^1.3.9",
    "remark-breaks": "^4.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@notionhq/client": "^5.27.0",
    "cross-env": "^10.1.0",
    "notion-to-md": "3.1.9",
    "pagefind": "^1.4.0"
  }
}
