---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";

const pathname = Astro.url.pathname;
const navItems = [
  { label: "글", href: "/posts" },
  { label: "소개", href: "/about" },
];
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);

const navClass =
  "rounded-md px-3 py-1.5 text-base text-black/70 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:text-white/70 dark:hover:bg-white/10 dark:hover:text-white dark:focus-visible:bg-white/10 dark:focus-visible:text-white";
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-y-2">
      <Link href="/" underline={false}>
        <div class="text-lg font-semibold text-black dark:text-white">
          {SITE.TITLE}
        </div>
      </Link>
      <nav class="flex items-center gap-1" aria-label="주 메뉴">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                navClass,
                isActive(item.href) &&
                  "bg-black/5 font-semibold text-black dark:bg-white/10 dark:text-white",
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <button
          id="magnifying-glass"
          aria-label="검색"
          class="ml-1 flex items-center gap-2 rounded-md border border-black/25 bg-white px-3 py-1.5 text-base text-black transition-colors duration-300 ease-in-out hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/30 dark:bg-neutral-900 dark:text-white dark:hover:bg-white/10 dark:focus-visible:bg-white/10"
        >
          <svg
            height="18"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="18"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
          <kbd
            class="hidden rounded border border-black/20 px-1.5 text-xs text-black/60 sm:inline dark:border-white/30 dark:text-white/60"
            >⌘K</kbd
          >
        </button>
      </nav>
    </div>
  </Container>
</header>
