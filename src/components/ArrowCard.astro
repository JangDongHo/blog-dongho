---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"posts">;
};

const { entry } = Astro.props;

const parts = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "2-digit",
  timeZone: "Asia/Seoul",
}).formatToParts(entry.data.date);
const year = parts.find((part) => part.type === "year")?.value;
const month = parts.find((part) => part.type === "month")?.value;
---

<a
  href={`/posts/${entry.id}`}
  class="not-prose group flex flex-nowrap gap-4 no-underline"
>
  <time
    datetime={entry.data.date.toISOString()}
    class="shrink-0 text-neutral-400 tabular-nums dark:text-neutral-500"
  >
    {year} · {month}
  </time>
  <span
    class="text-black underline decoration-black/30 underline-offset-[3px] transition-colors duration-300 ease-in-out group-hover:decoration-black/70 group-focus-visible:decoration-black/70 dark:text-white dark:decoration-white/30 dark:group-hover:decoration-white/70 dark:group-focus-visible:decoration-white/70"
  >
    {entry.data.title}
  </span>
</a>
