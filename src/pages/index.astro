---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">
        안녕하세요, {SITE.AUTHOR}입니다
      </h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <p>
              백엔드 개발자를 꿈꾸며 공부하고 만든 것들을 기록합니다. 누군가에게
              도움이 되는 서비스를 만드는 개발자가 되기 위해 꾸준히 배우고
              있습니다. 더 자세한 이야기는 <Link href="/about">소개</Link>에서 볼
              수 있습니다.
            </p>
          </article>
        </section>

        <section class="animate space-y-6">
          <h2 class="font-semibold text-black dark:text-white">글</h2>
          <ul class="not-prose flex flex-col gap-2">
            {
              posts.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
